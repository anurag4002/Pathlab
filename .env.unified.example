# Copy values into Vercel Environment Variables, not frontend/VITE variables.
# Existing Path Lab settings: keep its existing database, JWT secret and accounts.
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/purepathlab
JWT_SECRET=keep-the-existing-pathlab-signing-secret
CLIENT_URL=https://YOUR-DOMAIN/pathlab
PUBLIC_BASE_URL=https://YOUR-DOMAIN/pathlab
CORS_ORIGIN=https://YOUR-DOMAIN

# Business Hub uses a separate connection/database and its own cookie login.
HUB_MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/business_portal
HUB_MONGODB_DATABASE=business_portal
APP_ORIGIN=https://YOUR-DOMAIN
TRUST_PROXY=1

# Only needed by npm run setup:hub, not by normal API requests.
HUB_OWNER_EMAIL=owner@example.com
HUB_OWNER_PASSWORD=replace-with-at-least-12-characters
# Keep the Lab's existing email, SMS, OAuth and other settings as applicable.
