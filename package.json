{
  "name": "pure-path-lab",
  "version": "1.0.0",
  "description": "Pure Path Lab Laboratory Management System",
  "scripts": {
    "build": "node scripts/build-unified.cjs",
    "build:pathlab": "npm run build --prefix frontend",
    "build:hub": "npm run build --prefix business-portal",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend && npm install --prefix business-portal",
    "preview:unified": "node scripts/preview-unified.cjs",
    "dev:unified": "npm run build && npm run preview:unified",
    "setup:hub": "node scripts/setup-hub.cjs",
    "test:unified": "node --test tests/unified-deployment.test.cjs",
    "backend": "npm start --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "seed": "npm run seed --prefix backend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  }
}
