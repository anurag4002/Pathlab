# Pure Path Lab Configuration Guide
# Backend Environment (.env in backend directory)

PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/purepathlab?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
UPLOAD_DIR=src/uploads
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=PUREPATH

# Google & Facebook OAuth Configuration (Staff Logins)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/admin/login
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5173/admin/login
