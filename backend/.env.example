# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# CORS (allowlist-driven — never use origin:true in production)
# Comma-separated origins. Defaults to CLIENT_URL. Use "*" for local dev only.
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# MongoDB Connection String (Atlas / Local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/purepathlab?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# File Storage (Local private storage folder)
UPLOAD_DIR=src/uploads

# Patient Portal OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_DAILY_LIMIT=5

# SMS Provider Configuration (console | msg91 | twilio)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=PUREPATH
# Twilio (only when SMS_PROVIDER=twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp Cloud API (unset => console fallback)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Email via Brevo HTTP API (console | brevo; unset key => console fallback)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=

# Absolute public base encoded inside QR codes (backend serves /r/:token)
PUBLIC_BASE_URL=http://localhost:5001

# Google OAuth Credentials (Optional - for Staff Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/admin/login

# Facebook OAuth Credentials (Optional - for Staff Facebook Login)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5173/admin/login
