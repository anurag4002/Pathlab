PORT=4318
NODE_ENV=development
# Optional locally: without a URI, development starts isolated persistent MongoDB.
# Required in production. Never use the existing Path Lab database.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=business_portal
# Production public origin (must match the browser URL exactly):
# APP_ORIGIN=https://business.example.com
# Optional on first launch. Otherwise a random owner password is printed locally.
# INITIAL_OWNER_EMAIL=owner@example.com
# INITIAL_OWNER_PASSWORD=replace-with-a-long-unique-password
# For HTTPS behind a trusted reverse proxy:
# TRUST_PROXY=1
