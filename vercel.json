{
  "version": 2,
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix frontend && npm ci --prefix backend && npm ci --prefix business-portal",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/{src/assets/document-formats,node_modules/{pdfkit,fontkit,png-js,brotli}}/**"
    },
    "api/hub.js": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/hub-api(?:/(.*))?", "dest": "/api/hub.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" },
    {
      "src": "/r/(.*)",
      "status": 308,
      "headers": { "Location": "/pathlab/r/$1" }
    },
    {
      "src": "/patient/report",
      "status": 308,
      "headers": { "Location": "/pathlab/patient/report" }
    },
    {
      "src": "/reports",
      "status": 308,
      "headers": { "Location": "/pathlab/reports" }
    },
    {
      "src": "/(?:pathlab/)?assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/pathlab(?:/.*)?", "dest": "/pathlab/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
